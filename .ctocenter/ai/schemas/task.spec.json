{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ctocenter.dev/schemas/task.spec.json",
  "title": "Task Specification",
  "description": "Schema for structured, actionable tasks in the CTO Command Center",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "type",
    "priority",
    "estimatedHours",
    "acceptanceCriteria",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$",
      "description": "Unique task identifier in format: task-YYYY-MM-DD-NNN",
      "examples": ["task-2025-11-09-001"]
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 100,
      "description": "Clear, action-oriented title",
      "examples": ["Implement dark mode color system and theme context"]
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "description": "Detailed description of what needs to be done"
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bug", "chore", "docs", "test", "refactor", "security"],
      "description": "Type of work"
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "Task priority"
    },
    "estimatedHours": {
      "type": "number",
      "minimum": 0,
      "maximum": 160,
      "description": "Estimated hours to complete (0-160)"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
      },
      "description": "Array of task IDs that must be completed first",
      "default": []
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      },
      "minItems": 1,
      "description": "Specific, testable criteria for completion"
    },
    "technicalNotes": {
      "type": "string",
      "description": "Implementation guidance, gotchas, references",
      "default": ""
    },
    "relatedDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path", "reason"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["adr", "playbook", "runbook", "reference", "guide"]
          },
          "path": {
            "type": "string",
            "description": "Path to document relative to repo root"
          },
          "reason": {
            "type": "string",
            "description": "Why this document is relevant"
          }
        }
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "Tags for categorization and filtering",
      "default": []
    },
    "assignee": {
      "type": "string",
      "description": "Team or person assigned to this task"
    },
    "milestone": {
      "type": "string",
      "description": "Release or sprint milestone"
    },
    "blockedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "External blockers (not task dependencies)",
      "default": []
    },
    "status": {
      "type": "string",
      "enum": ["backlog", "ready", "in-progress", "blocked", "review", "done"],
      "default": "backlog"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of completion"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "source": {
          "type": "string",
          "description": "Where this task originated (epic, incident, etc.)"
        },
        "links": {
          "type": "object",
          "properties": {
            "github": {
              "type": "string",
              "format": "uri"
            },
            "jira": {
              "type": "string",
              "format": "uri"
            },
            "slack": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
